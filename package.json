{
  "name": "bakkerij-de-tureluur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website for Bakkerij de Tureluur",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.14.0"
  },
  "engineStrict": true,
  "packageManager": "pnpm@10.14.0",
  "volta": {
    "node": "22.18.0",
    "pnpm": "10.14.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"./src/**/*.{js,ts,tsx}\"",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier \"**/*.{html,scss,md,ts,tsx,js,mjs,yml,json}\" --check",
    "format:fix": "prettier \"**/*.{html,scss,md,ts,tsx,js,mjs,yml,json}\" --write --list-different",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "seed": "payload run src/backend/seed.ts",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@payloadcms/db-postgres": "^3.89.0",
    "@payloadcms/next": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "@payloadcms/storage-vercel-blob": "^3.89.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "next": "16.3.5",
    "payload": "^3.89.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^13.5.11",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "include-media": "^2.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.83.4",
    "typescript": "^5.9.3"
  }
}
