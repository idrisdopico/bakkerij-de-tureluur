# Signs Payload's tokens and session cookies. Generate a long, random,
# unguessable string (e.g. `openssl rand -base64 32`) and keep it stable
# across deploys — rotating it invalidates every existing login session.
PAYLOAD_SECRET=DCgv9leTSBZz8g/ocdrrph4+Jq4LCb4ddsKZVV/Lrxo=

# Postgres connection string, e.g. from Neon or Vercel Postgres.
# Format: postgres://user:password@host:port/database
DATABASE_URL=

# Vercel Blob read/write token — only needed in production (or if you want
# to test Blob storage locally). Without it, Payload stores uploads on local
# disk under public/media, which is enough for local development.
# Vercel sets this automatically once Blob storage is attached to the
# project; see https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Public site origin, used for canonical URLs, Open Graph, sitemap.xml,
# robots.txt and JSON-LD structured data. No trailing slash. Set this to the
# real domain in production (e.g. https://www.bakkerijdetureluur.nl); defaults
# to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# --- Ordering (cart → order email) ---

# Gmail SMTP credentials used to send order emails (see the `email` adapter in
# src/payload.config.ts). SMTP_USER is the Gmail address; SMTP_PASS is a Google
# *App Password* (needs 2-Step Verification enabled on the account) — NOT the
# normal account password. Leave both blank locally to have Payload log emails
# to the console instead of sending them.
SMTP_USER=
SMTP_PASS=

# Where order emails are sent. Always a fixed, trusted address (never a
# customer-supplied one). Defaults to SMTP_USER if left blank.
ORDER_TO_EMAIL=detureluur@gmail.com

# Cloudflare Turnstile keys (free bot protection on the order form). Create a
# widget at https://dash.cloudflare.com/?to=/:account/turnstile and add your
# domain. For local development you can use Cloudflare's "always passes" test
# keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
